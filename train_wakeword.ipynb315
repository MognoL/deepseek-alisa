    {
      "cell_type": "code",
      "source": [
        "import torch\n",
        "\n",
        "# Патч для PyTorch 2.6+: принудительно weights_only=False\n",
        "_original_torch_load = torch.load\n",
        "\n",
        "def _patched_torch_load(*args, **kwargs):\n",
        "    kwargs['weights_only'] = False\n",
        "    return _original_torch_load(*args, **kwargs)\n",
        "\n",
        "torch.load = _patched_torch_load\n",
        "print(\"torch.load patched: weights_only=False\")"
      ],
      "metadata": {
        "id": "y29Z38STzfLf",
        "outputId": "18f36683-268b-47cc-9d47-08674f1a2e90",
        "colab": {
          "base_uri": "https://localhost:8080/"
        }
      },
      "execution_count": 1,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "torch.load patched: weights_only=False\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "import torch\n",
        "\n",
        "# Запоминаем оригинальную функцию torch.load\n",
        "_original_torch_load = torch.load\n",
        "\n",
        "# Определяем новую функцию, которая всегда использует weights_only=False\n",
        "def _patched_torch_load(*args, **kwargs):\n",
        "    # Принудительно устанавливаем weights_only=False\n",
        "    kwargs['weights_only'] = False\n",
        "    return _original_torch_load(*args, **kwargs)\n",
        "\n",
        "# Заменяем torch.load на нашу версию\n",
        "torch.load = _patched_torch_load"
      ],
      "metadata": {
        "id": "UzUwk8i2tBOG"
      },
      "execution_count": 2,
      "outputs": []
    },
